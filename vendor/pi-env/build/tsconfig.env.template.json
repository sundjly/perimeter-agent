{
	"extends": "{{SDKROOT}}/tsconfig.base.json",
	"compilerOptions": {
		"outDir": "{{OUTDIR}}",
		"rootDir": "{{SDKROOT}}/packages/env/src",
		"paths": {
			"@earendil-works/chord": ["{{PERIMETER_NODE_MODULES}}/@earendil-works/chord/dist/index.d.ts"],
			"@earendil-works/chord/context": ["{{PERIMETER_NODE_MODULES}}/@earendil-works/chord/dist/context/index.d.ts"],
			"@earendil-works/pi-durable/env": ["{{PERIMETER_NODE_MODULES}}/@earendil-works/pi-durable/dist/env/index.d.ts"]
		},
		"typeRoots": ["{{SDKROOT}}/node_modules/@types"],
		"noEmit": false
	},
	"include": ["{{SDKROOT}}/packages/env/src/**/*.ts"],
	"exclude": ["**/*.d.ts"]
}
