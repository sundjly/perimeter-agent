{
  "name": "perimeter-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "可完全私有部署的 code agent 运行时 —— 代码与凭据永不出客户网络边界，浏览器只是零安装的操作面",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "crossverify": "node --test tests/sigv4-crossverify.test.ts",
    "gateway": "node src/gateway/server.ts",
    "modelgw": "node src/modelgw/server.ts",
    "gitproxy": "node src/gitproxy/server.ts",
    "demo": "node scripts/demo.ts",
    "gen:netpol": "node scripts/gen-netpol.ts"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "aws4": "^1.13.2",
    "typescript": "^5.7.2"
  }
}
